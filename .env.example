# CircuitGit environment. Copy to .env and fill in.
# Secrets are SERVER-SIDE ONLY: they are read by apps/api, never bundled into
# apps/web or the AR client, and never committed.

# ---- LLM provider (required for any LLM-backed check) ----
# Without this the gateway reports status: unavailable. It never falls back to
# canned text.
ANTHROPIC_API_KEY=

# ---- Supabase ----
# Public values, safe to expose to the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Server-side only. Bypasses row-level security: never expose to the client.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- API service ----
API_PORT=8787
# Origin allowed to call the API. Include the LAN HTTPS origin you use for Quest
# testing, e.g. https://192.168.1.20:5173
API_ALLOWED_ORIGINS=https://localhost:5173

# ---- Simulation ----
# Path to the ngspice binary when simulation.ngspice.mode is "native".
NGSPICE_BINARY=ngspice

# ---- Optional overrides ----
# Alternate config file; defaults to config/default.yaml.
CIRCUITGIT_CONFIG=
