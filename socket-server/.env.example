# Create .env from this file and add your server-side OpenAI API key.
OPENAI_API_KEY=your_openai_api_key_here

# Optional: enables Reka-powered voice questions in the dashboard chat.
REKA_API_KEY=your_reka_api_key_here
# REKA_MODEL=reka-flash-3

# Voice replies are generated with OpenAI and played by the dashboard.
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=alloy

# Optional live-demo tuning.
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_TIMEOUT_MS=8000
