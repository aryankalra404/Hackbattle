# Create .env from this file and add your server-side OpenAI API key.
OPENAI_API_KEY=your_openai_api_key_here

# Voice questions are transcribed with OpenAI Whisper and replied to with
# OpenAI TTS, played by the dashboard.
# OPENAI_STT_MODEL=whisper-1
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=alloy

# Optional live-demo tuning.
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_TIMEOUT_MS=8000
